{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::videos/users/*/videos/*/source", "arn:aws:s3:::videos/results/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::videos"],
      "Condition": {"StringLike": {"s3:prefix": ["users/*"]}}
    }
  ]
}
